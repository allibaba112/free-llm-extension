{
  "name": "free-llm-router",
  "displayName": "Free LLM Router",
  "description": "Intelligent routing to free LLM APIs with automatic provider selection and rate limiting",
  "version": "0.1.0",
  "publisher": "allibaba112",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "activationEvents": [
    "onLanguage",
    "onCommand:freeLlmRouter.configure",
    "onCommand:freeLlmRouter.complete"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "freeLlmRouter.configure",
        "title": "Free LLM: Configure Providers",
        "description": "Set up API keys and provider preferences"
      },
      {
        "command": "freeLlmRouter.complete",
        "title": "Free LLM: Get Completion",
        "description": "Get code completion from available free LLM"
      },
      {
        "command": "freeLlmRouter.showStatus",
        "title": "Free LLM: Show Provider Status",
        "description": "View current provider status and rate limits"
      }
    ],
    "configuration": {
      "title": "Free LLM Router",
      "properties": {
        "freeLlmRouter.groqApiKey": {
          "type": "string",
          "markdownDescription": "Groq API Key from https://console.groq.com",
          "scope": "machine"
        },
        "freeLlmRouter.openrouterApiKey": {
          "type": "string",
          "markdownDescription": "OpenRouter API Key from https://openrouter.ai",
          "scope": "machine"
        },
        "freeLlmRouter.cohereApiKey": {
          "type": "string",
          "markdownDescription": "Cohere API Key from https://cohere.com",
          "scope": "machine"
        },
        "freeLlmRouter.enabledProviders": {
          "type": "array",
          "default": ["groq", "openrouter"],
          "items": {
            "type": "string",
            "enum": ["groq", "openrouter", "cohere", "cloudflare", "mistral"]
          },
          "description": "Which providers to use for completions"
        },
        "freeLlmRouter.preferredModel": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Preferred model or 'auto' for intelligent selection"
        },
        "freeLlmRouter.maxTokens": {
          "type": "integer",
          "default": 256,
          "description": "Maximum tokens per completion"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "eslint": "^8.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
