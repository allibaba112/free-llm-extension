{
  "name": "free-llm-router",
  "displayName": "Free LLM Router",
  "description": "Intelligent routing to free LLM APIs with automatic provider selection and rate limiting",
  "version": "0.1.0",
  "publisher": "allibaba112",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "freeLlmRouter.configure",
        "title": "Free LLM: Configure Providers",
        "description": "Set up API keys and provider preferences"
      },
      {
        "command": "freeLlmRouter.complete",
        "title": "Free LLM: Get Completion",
        "description": "Get code completion from available free LLM"
      },
      {
        "command": "freeLlmRouter.showStatus",
        "title": "Free LLM: Show Provider Status",
        "description": "View current provider status and rate limits"
      }
    ],
    "configuration": {
      "title": "Free LLM Router",
      "properties": {
        "freeLlmRouter.enabledProviders": {
          "type": "array",
          "default": [
            "groq",
            "openrouter"
          ],
          "items": {
            "type": "string",
            "enum": [
              "groq",
              "openrouter",
              "cohere",
              "cloudflare",
              "mistral",
              "cerebras"
            ]
          },
          "description": "Which providers to use for completions"
        },
        "freeLlmRouter.preferredModel": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Preferred model or 'auto' for intelligent selection"
        },
        "freeLlmRouter.maxTokens": {
          "type": "integer",
          "default": 256,
          "description": "Maximum tokens per completion"
        },
        "freeLlmRouter.cloudflareAccountId": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Cloudflare account ID (required only for Cloudflare Workers AI)"
        },
        "freeLlmRouter.groqModel": { "type": "string", "default": "llama-3.3-70b-versatile" },
        "freeLlmRouter.openrouterModel": { "type": "string", "default": "meta-llama/llama-3.3-70b-instruct:free" },
        "freeLlmRouter.cohereModel": { "type": "string", "default": "command-a-03-2025" },
        "freeLlmRouter.mistralModel": { "type": "string", "default": "mistral-small-latest" },
        "freeLlmRouter.cerebrasModel": { "type": "string", "default": "gpt-oss-120b" },
        "freeLlmRouter.cloudflareModel": { "type": "string", "default": "@cf/meta/llama-3.1-8b-instruct" }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./dist/test/rateLimiter.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.30.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
